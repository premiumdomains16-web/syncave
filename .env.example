# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"


# Supabase (optional). When both are set the server stores users, sessions, bots,
# orders, unanswered questions and uploaded images in Supabase instead of ./data.
# Project settings → API → Project URL / service_role key (server-only secret!).
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Firebase web config (optional). Public values; copied from Firebase console > Project settings > Your apps.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""

# Supabase public (anon / publishable) key, used by the browser for sign-in. Safe to expose.
VITE_SUPABASE_ANON_KEY=""
# Optional: override the API address (default: ${SUPABASE_URL}/functions/v1)
VITE_API_URL=""
